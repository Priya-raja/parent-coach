# Configure at least ONE provider. Leave unused keys blank.
# Selection order: Anthropic, Google Gemini, OpenAI.
# Copy this file to .env.local and replace the appropriate blank value.

# Option 1: Anthropic (Claude) — key format: sk-ant-...
ANTHROPIC_API_KEY=
# Optional override; default: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Option 2: Google Gemini — key format: AIza...
# Get a key and check free-tier availability: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override; default: gemini-1.5-flash
# GOOGLE_MODEL=gemini-1.5-flash

# Option 3: OpenAI — key format: sk-...
OPENAI_API_KEY=
# Optional override; default: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Restart the development server after changing these values.
